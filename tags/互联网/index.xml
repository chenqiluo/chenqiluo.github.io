&lt;div class="sr-kv">&lt;div class="sr-k">涨跌幅&lt;/div>&lt;div class="sr-v sr-val-green">+2.24%&lt;/div>&lt;/div>
&lt;div class="sr-kv">&lt;div class="sr-k">开盘/最高/最低&lt;/div>&lt;div class="sr-v">478.0 / 494.8 / 477.4&lt;/div>&lt;/div>
